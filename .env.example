# MediSense Master Environment Variable Example Template

# Node.js Express Backend (.env in /server)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/medisense
JWT_SECRET=your_jwt_secret_key_here
AI_SERVICE_URL=http://127.0.0.1:8000

# Python FastAPI AI Microservice (.env in /ai-service)
AI_PORT=8000
AI_HOST=127.0.0.1
GEMINI_API_KEY=your_gemini_api_key_here

# React Client (.env in /client - optional)
VITE_API_BASE_URL=http://localhost:5000
